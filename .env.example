# ─── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI (Gemini) ─────────────────────────────────────────────────────────────
# IMPORTANT: everything prefixed VITE_ is inlined into the JavaScript bundle and
# is therefore public. Never put a real Gemini key in a deployed build.
#
# Deployed environments: point at the backend proxy, which holds the key
# server-side and requires a signed-in Supabase session.
VITE_AI_PROXY_URL=https://your-backend.onrender.com/api/ai

# Local development only. Ignored in production builds.
# VITE_GEMINI_API_KEY=your_gemini_api_key

# ─── ML backend ──────────────────────────────────────────────────────────────
VITE_ML_ENABLED=true
VITE_ML_API_URL=http://localhost:8000/api
# Must match ML_API_KEY on the backend. This value is public (see above), so
# treat it as a throttle, not as a secret.
VITE_ML_API_KEY=

# ─── Dev-only flags (ignored in production builds) ───────────────────────────
VITE_SEED_TEST_DATA=false
VITE_CLEAR_SEED_DATA=false
VITE_AUTO_ANALYZE=false
# Extra hostnames the Vite dev server may be served under (e.g. an ngrok tunnel)
VITE_DEV_ALLOWED_HOSTS=


# ═════════════════════════════════════════════════════════════════════════════
# Backend (backend/.env) — server-side only, never prefixed with VITE_
# ═════════════════════════════════════════════════════════════════════════════
# GEMINI_API_KEY=your_gemini_api_key
# ML_API_KEY=generate_a_long_random_string
# CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
